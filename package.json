{
  "name": "options-lab",
  "version": "2.4.0",
  "private": true,
  "description": "Nexus Options Lab – build step for the Tailwind stylesheet only; the app itself is plain index.html",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
