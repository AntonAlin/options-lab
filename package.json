{
  "name": "options-lab",
  "version": "3.0.0",
  "private": true,
  "description": "Nexus Portfolio Lab – static site. npm only builds the Options Lab Tailwind stylesheet and runs the tests.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o tailwind.css --watch",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
